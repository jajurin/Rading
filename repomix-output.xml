      <View style={styles.cardFooterRow}>
        <View style={[styles.badge, item.fijo ? styles.badgeFijo : styles.badgeSubasta]}>
          <Text style={[styles.badgeText, item.fijo && styles.badgeTextDark]}>
            {item.fijo ? 'Fijo' : 'Subasta'}
