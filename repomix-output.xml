      {preguntas.map((p, idx) => (
        <PreguntaItem
          key={idx}
          pregunta={p.pregunta}
          opciones={p.opciones}
          seleccion={respuestas[idx]}
          textoOtro={textosOtro[idx] || ""}
          onSeleccionar={(valor) => onSeleccionar(idx, valor)}
          onCambiarTexto={(texto) => onCambiarTexto(idx, texto)}
