        <View style={styles.aclaracionIconWrap}>
          <Ionicons name="help" size={16} color="#fff" />
        </View>
        <Text style={styles.aclaracionTitulo}>
          {preguntas.length > 1 ? "Necesitamos un poco más de info" : "Necesitamos un dato más"}
        </Text>
