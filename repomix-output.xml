          <Text style={styles.cardPrecio}>
            {item.precio != null ? `$${Number(item.precio).toLocaleString('es-AR')}` : 'A convenir'}
          </Text>
        </View>

        <View style={[styles.estadoBadge, { backgroundColor: `${estadoColor}22` }]}>
