    }
    return resultado
}
    confirmarFin = async (idTrabajo, rol) => {
        if (!idTrabajo || !ROLES.includes(rol)) {
            throw new Error('Faltan idTrabajo o rol (CLIENTE | TRABAJADOR)')
        }
