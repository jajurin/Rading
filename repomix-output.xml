            >
              <Text style={styles.applyBtnText}>Aplicar filtros</Text>
              <Ionicons name="arrow-forward" size={16} color={WHITE} />
            </TouchableOpacity>
          </View>
        </View>
      </View>
    </Modal>
  )
};

