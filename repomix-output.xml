  KeyboardAvoidingView,
  TextInput,
  Alert,
  ActivityIndicator,
} from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { useTheme } from './ThemeContext';
import Header from './Header';
import API_URL from './configS';

/* ------------------------------------------------------------------ */
