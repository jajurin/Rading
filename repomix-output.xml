            <Text style={[styles.filterLabel, { marginTop: 22 }]}>Rango de precio ($)</Text>
            <View style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
              <TextInput
                style={[styles.timeInputBox, { width: 100, fontSize: 14 }]}
                value={precioMin}
                onChangeText={setPrecioMin}
